# Copy to `.env` and edit. Nothing here is required to run the app: with an
# empty file it boots fully public, reports nothing to the hub, and serves
# every documentation page (Premium components degrade to a watermark without
# the MUI X license). Each block below says what turns ON when you set it,
# and what the app does when you don't.
#
# `.env` is gitignored and excluded from the Docker image — keep it that way.
#
# Values are read by `lib/backend.py`'s `load_dotenv()` at import time, which
# NEVER overrides a variable already in the environment. On Render, set these
# in the dashboard rather than committing a file.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# flask | fastapi. Flask is the local default; production (render.yaml) runs
# fastapi. See lib/backend.py for the DASH_BACKEND > BACKENDS > BACKEND order.
# DASH_BACKEND=flask
# PORT=8560

# ---------------------------------------------------------------------------
# Canonical origin — THE value to get right
# ---------------------------------------------------------------------------
# Drives <link rel="canonical">, og:url, sitemap.xml, robots.txt and every
# absolute URL in llms.txt (lib/constants.BASE_URL). Production is
# https://muischeduler.2plot.dev; see render.yaml for the domain-move order
# before flipping CANONICAL_HOST_REDIRECT.
# APP_BASE_URL=https://muischeduler.2plot.dev
# CANONICAL_HOST_REDIRECT=0

# ---------------------------------------------------------------------------
# MUI X license (perpetual LICENSE key — not metered; safe to set)
# ---------------------------------------------------------------------------
# Docs examples read MUI_X_LICENSE_KEY (licenseKey=os.environ.get(...)).
# Locally the value lives as MUI_PRO_API_KEY with an alias line. Blank just
# degrades Premium components to a watermark.
# MUI_PRO_API_KEY=
# MUI_X_LICENSE_KEY=${MUI_PRO_API_KEY}

# ---------------------------------------------------------------------------
# Network analytics (lib/analytics_tracker + lib/satellite_reporter)
# ---------------------------------------------------------------------------
# The shared network secret. Set: an hourly signed rollup of this app's
# traffic POSTs to 2plot.ai and the app appears on the owner-only /traffic
# dashboard. Unset: the reporter is a clean no-op (no thread, no network).
# CROSS_APP_WEBHOOK_SECRET=
# ONE short app id, network-wide (the subdomain slug / hub directory key).
# AD_APP_ID and the bulletin app_id follow this value in code.
# SATELLITE_APP_KEY=muischeduler
# Where the visitor ledger lives. On Render this points at the persistent
# disk (/var/data/visitor_analytics.json) so daily figures survive deploys.
# TRAFFIC_ANALYTICS_FILE=visitor_analytics.json
# SATELLITE_REPORT_INTERVAL_S=3600
# ANALYTICS_MAX_VISITS=20000
# ANALYTICS_GEO_LOOKUP=1

# ---------------------------------------------------------------------------
# Network bulletin (hub tips/announcements in the llms.txt viewer)
# ---------------------------------------------------------------------------
# NETWORK_BULLETIN_URL=https://2plot.dev/api/network/bulletin

# ---------------------------------------------------------------------------
# Corpus document tiers (lib/page_tiers.py; registered in run.py)
# ---------------------------------------------------------------------------
# Access tier for the tiered corpus documents served by dash-improve-my-llms
# >= 2.4.0: /llms-small.txt (compact briefing) and /llms-full.txt (every
# page's prose in one fetch). Values: public | auth | admin | hidden.
# Unset = public — the network's standing policy is that discovery documents
# stay free; these knobs exist so the 402 experiment can tighten the full
# corpus per-satellite without a redeploy of anything else. The hub's
# page-tier ceilings can also tighten either network-wide (a satellite can
# never loosen below the hub). Inert on older package versions.
# LLMS_SMALL_TIER=public
# LLMS_FULL_TIER=public

# ---------------------------------------------------------------------------
# Clerk auth. LIVE in production (env group C); a clean no-op with no CLERK_*
# keys, which is the local default — see lib/auth.py, the single source of
# truth for "is auth on". DISABLE_CLERK=1 reads as "intentionally off"
# without touching the values below, which is the reliable way to run an
# auth-off session when a shell env prefix doesn't survive an IDE run config.
# ---------------------------------------------------------------------------
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# CLERK_FRONTEND_API=https://clerk.2plot.ai
# CLERK_SIGN_IN_URL=https://accounts.2plot.ai/sign-in
# CLERK_IS_SATELLITE=true
# CLERK_SATELLITE_DOMAIN=muischeduler.2plot.dev
# SESSION_SECRET=
# Where the Sign In button sends people. Unset strands authenticated users on
# the primary; a truthy NON-URL 404s the button — lib/auth boot-guards both,
# and the absence of its two [auth] warnings in the log is the check.
# CLERK_SATELLITE_SIGN_IN_REDIRECT=https://2plot.ai/onboarding
# DISABLE_CLERK=1

# ---------------------------------------------------------------------------
# The interactive gate (lib/page_tiers, lib/access, lib/gate_layouts)
# ---------------------------------------------------------------------------
# Who may read a page whose frontmatter declares no `tier:`. Shipped as
# `public` — the gate is fully wired and nothing is gated. Flipping this to
# `auth` gates the interactive site with no code change; flipping it back is
# the rollback. It does NOT touch LLMS_SMALL_TIER / LLMS_FULL_TIER above,
# which run.py registers with an explicit `or "public"` for that reason.
# PAGE_DEFAULT_TIER=public
#
# The SECOND axis: do the machine surfaces (/<page>/llms.txt, crawler HTML,
# the prerender) stay open on a gated page? Unset = open, and it stays unset
# network-wide until phase 4 — that is the data-window posture.
# LLMS_PUBLIC_DEFAULT=
#
# The control board's override store (/admin/control-board). In production
# this MUST sit on the mounted disk beside the analytics ledger, or every
# deploy silently wipes the board. The [visibility] boot warning names it.
# PAGE_VISIBILITY_FILE=/var/data/page_visibility.json
#
# Admin allowlist for /admin/*. OWNER_EMAIL always counts. Admin surfaces
# fail CLOSED when Clerk is unavailable — ALLOW_UNGATED_ADMIN=1 to work on
# them locally, NEVER in production.
# ADMIN_EMAILS=
# ADMIN_USER_IDS=
# ALLOW_UNGATED_ADMIN=1
